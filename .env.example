# ===== Database (Neon / PostgreSQL) =====
# Neon のダッシュボード → Connection string からコピー。末尾の ?sslmode=require は必須。
# 例: postgresql://<user>:<password>@<ep-xxxx>.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# ===== Auth (Manus OAuth) =====
# 管理者ログインに使用。OWNER_OPEN_ID と一致したユーザーが自動で admin になる。
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
# フロントのログインURL生成に使用（client/src/const.ts）
VITE_OAUTH_PORTAL_URL=

# ===== Storage / LLM (Manus Forge) =====
# 記事画像のアップロード・配信プロキシに使用。
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ===== SMTP (会員メール認証) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== Runtime =====
# 省略時は 3000 から空きポートを自動探索。
PORT=3000
